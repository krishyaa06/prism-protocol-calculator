* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'JetBrains Mono', monospace;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: radial-gradient(circle at 50% 10%, #0d172e 0%, #05070c 80%);
    color: #e2e8f0;
    padding: 15px;
}

.terminal-card {
    width: 100%;
    max-width: 400px;
    background: rgba(10, 14, 23, 0.9);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(0, 210, 255, 0.25);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 0 35px rgba(0, 140, 255, 0.25);
}

.terminal-header {
    margin-bottom: 20px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
}

.brand-logo {
    width: 42px;
    height: 42px;
    object-fit: contain;
    filter: drop-shadow(0 0 8px #00d2ff);
}

.brand-text h1 {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #ffffff;
}

.status-badge {
    font-size: 0.65rem;
    color: #00d2ff;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.pulse {
    width: 6px;
    height: 6px;
    background: #00d2ff;
    border-radius: 50%;
    box-shadow: 0 0 8px #00d2ff;
    animation: blink 1.5s infinite;
}

@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}

.nav-modes {
    display: flex;
    gap: 6px;
    background: #090e18;
    padding: 4px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.mode-btn {
    flex: 1;
    background: transparent;
    border: none;
    color: #64748b;
    padding: 8px 0;
    font-size: 0.75rem;
    cursor: pointer;
    border-radius: 6px;
    font-weight: 600;
    transition: 0.2s ease;
}

.mode-btn.active {
    background: #0051ff;
    color: #ffffff;
    box-shadow: 0 0 10px rgba(0, 81, 255, 0.5);
}

.display-panel {
    background: #060911;
    border: 1px solid rgba(0, 210, 255, 0.15);
    border-radius: 12px;
    padding: 16px;
    text-align: right;
    margin-bottom: 18px;
    min-height: 85px;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
}

.history-line {
    font-size: 0.85rem;
    color: #64748b;
    min-height: 1.2rem;
    word-break: break-all;
}

.main-line {
    font-size: 2rem;
    font-weight: 700;
    color: #00d2ff;
    text-shadow: 0 0 12px rgba(0, 210, 255, 0.4);
    word-break: break-all;
}

.extra-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 12px;
    background: #0c111d;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid rgba(0, 210, 255, 0.1);
}

.keypad {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.btn {
    height: 52px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: #101625;
    color: #ffffff;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.15s ease;
}

.btn:active {
    transform: scale(0.96);
}

.btn-op {
    background: #0f223f;
    color: #00d2ff;
}

.btn-action {
    background: #23121b;
    color: #ff3b69;
}

.btn-sci-op {
    background: #141c2e;
    color: #38bdf8;
    font-size: 0.9rem;
}

.btn-equal {
    background: linear-gradient(135deg, #0051ff, #00d2ff);
    color: #ffffff;
    font-weight: 800;
}
